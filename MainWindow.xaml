<Window x:Class="RadeonTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="app.ico" Title="RDNA Panel" WindowStyle="None" ResizeMode="CanResize" MinWidth="880" MinHeight="560"
        Width="1100" Height="660" WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Background="#1C1C1E">

  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>


  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="#303032"/>
      <Setter Property="CornerRadius" Value="10"/>
    </Style>
    <Style x:Key="SideItem" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#8E8E93"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="14,0"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,1">
              <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="#3A3A3C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Row" TargetType="Grid">
      <Setter Property="Height" Value="44"/>
    </Style>
    <Style x:Key="RowLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#E5E5EA"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8E8E93"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Margin" Value="6,18,0,8"/>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="52"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 标题栏 -->
    <Grid Grid.Row="0" Background="#1C1C1E" MouseLeftButtonDown="TitleBar_Drag">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
        <Border Width="9" Height="9" CornerRadius="4.5" Background="#FF453A" Margin="0,0,10,0"/>
        <TextBlock Text="RDNA Panel" Foreground="#F2F2F7" FontSize="13" FontWeight="SemiBold"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0">
        <Button x:Name="MinBtn" Content="—" Width="28" Height="24" Background="Transparent" BorderThickness="0" Foreground="#8E8E93"/>
        <Button x:Name="MaxBtn" Content="□" Width="46" Height="32" Background="Transparent" BorderThickness="0"
                Foreground="#8E8E93" FontSize="12" ToolTip="最大化 / 还原"/>
            <Button x:Name="CloseBtn" Content="✕" Width="28" Height="24" Background="Transparent" BorderThickness="0" Foreground="#8E8E93"/>
      </StackPanel>
    </Grid>

    <Popup x:Name="TipPopup" Placement="Mouse" AllowsTransparency="True" StaysOpen="True" IsHitTestVisible="False">
      <Border Background="#2C2C2E" BorderBrush="#5A5A5C" BorderThickness="1" CornerRadius="6" Padding="10,7" MaxWidth="380">
        <TextBlock x:Name="TipText" Foreground="#F2F2F7" FontSize="12" TextWrapping="Wrap"/>
      </Border>
    </Popup>

    <!-- 主体：侧栏 + 内容 -->
    <Grid Grid.Row="1" Margin="0,0,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="190"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 侧栏 -->
      <Border Grid.Column="0" Background="#232325" CornerRadius="12" Margin="12,0,0,12">
        <StackPanel Margin="0,14,0,0">

          <StackPanel x:Name="ScopeHost" Margin="0,0,0,0"/>
          <TextBlock Text="显示设置" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="22,14,0,6"/>
          <Button x:Name="NavDisplayBasic" Content="基本" Tag="display:basic" Click="Nav_Click" Style="{StaticResource SideItem}"/>
          <Button x:Name="NavDisplayCustom" Content="自定义" Tag="display:custom" Click="Nav_Click" Style="{StaticResource SideItem}"/>
          <Button x:Name="NavDisplayScale" Content="缩放" Tag="display:scale" Click="Nav_Click" Style="{StaticResource SideItem}"/>
          <TextBlock Text="硬件" Foreground="#8E8E93" FontSize="11" FontWeight="SemiBold" Margin="22,14,0,6"/>
          <Button x:Name="NavOc" Content="超频" Tag="oc" Click="Nav_Click" Style="{StaticResource SideItem}"/>
          <Button x:Name="NavProfiles" Content="配置" Tag="profiles" Click="Nav_Click" Style="{StaticResource SideItem}"/>

          <Border Height="1" Background="#2C2C2E" Margin="20,16,20,16"/>

          <TextBlock x:Name="StatusText" Foreground="#636366" FontSize="10" Margin="22,0,22,10" Text="ready" TextWrapping="Wrap"/>
          <TextBlock x:Name="GpuText" Visibility="Collapsed"/>
          <TextBlock x:Name="DispText" Visibility="Collapsed"/>
        </StackPanel>
      </Border>

      <Border Grid.Column="0" Width="1" HorizontalAlignment="Right" Background="#2A2A2C" Margin="0,12,0,12"/>

      <!-- 内容 -->
      <Grid Grid.Column="1" Margin="24,6,20,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部大数字 -->
        <!-- 首页整体容器：切换页面时只切这一个 -->
        <StackPanel x:Name="HomePanel" Grid.Row="0" Grid.RowSpan="4">
<StackPanel x:Name="HeroPanel" Orientation="Horizontal">
          <StackPanel Margin="0,0,52,0">
            <TextBlock x:Name="ClockCaption" Text="核心频率" Foreground="#8E8E93" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock x:Name="ClockText" Text="—" Style="{StaticResource BigNum2}"/>
              <TextBlock Text="MHz" Foreground="#8E8E93" FontSize="13" VerticalAlignment="Bottom" Margin="6,0,0,8"/>
            </StackPanel>
            <TextBlock x:Name="ClockSubText" Text="" Foreground="#FF453A" FontSize="11" Margin="2,0,0,0"/>
          </StackPanel>
          <StackPanel>
            <TextBlock x:Name="VoltCaption" Text="电压偏移" Foreground="#8E8E93" FontSize="11"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
              <TextBlock x:Name="VoltBigText" Text="—" Foreground="#F2F2F7" FontSize="40"
                         FontFamily="Segoe UI Variable Display, Segoe UI Light"/>
              <TextBlock Text="mV" Foreground="#8E8E93" FontSize="13" VerticalAlignment="Bottom" Margin="6,0,0,8"/>
            </StackPanel>
            <TextBlock x:Name="PowerText" Text="" Foreground="#8E8E93" FontSize="11" Margin="2,0,0,0"/>
          </StackPanel>
          <WrapPanel x:Name="GpuSelectorHost" Margin="40,0,0,0" VerticalAlignment="Center" MaxWidth="520"/>
        </StackPanel>

        <Border x:Name="MonStrip1" Background="#232325" CornerRadius="10" Margin="0,4,0,14" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="16,12,0,12">
              <TextBlock Text="核心频率" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonClock" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#2A2A2C" Margin="0,12"/>
            <StackPanel Grid.Column="2" Margin="16,12,0,12">
              <TextBlock Text="边缘温度" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonEdge" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="3" Background="#2A2A2C" Margin="0,12"/>
            <StackPanel Grid.Column="4" Margin="16,12,0,12">
              <TextBlock Text="热点温度" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonHot" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="5" Background="#2A2A2C" Margin="0,12"/>
            <StackPanel Grid.Column="6" Margin="16,12,0,12">
              <TextBlock Text="整卡功耗" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonPower" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="7" Background="#2A2A2C" Margin="0,12"/>
            <StackPanel Grid.Column="8" Margin="16,12,0,12">
              <TextBlock Text="风扇" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonFan" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border x:Name="MonStrip2" Background="#232325" CornerRadius="10" Margin="0,0,0,14" Padding="0">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1"/><ColumnDefinition Width="*"/><ColumnDefinition Width="1"/>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="16,10,0,10">
              <TextBlock Text="显存频率" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonMem" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#2A2A2C" Margin="0,10"/>
            <StackPanel Grid.Column="2" Margin="16,10,0,10">
              <TextBlock Text="显存温度" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonMemTemp" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="3" Background="#2A2A2C" Margin="0,10"/>
            <StackPanel Grid.Column="4" Margin="16,10,0,10">
              <TextBlock Text="GPU 电压" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonVolt" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="5" Background="#2A2A2C" Margin="0,10"/>
            <StackPanel Grid.Column="6" Margin="16,10,0,10">
              <TextBlock Text="风扇转速" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonFanRpm" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
            <Border Grid.Column="7" Background="#2A2A2C" Margin="0,10"/>
            <StackPanel Grid.Column="8" Margin="16,10,0,10">
              <TextBlock Text="GFX 活动" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="MonAct" Text="—" Style="{StaticResource Num2}" Margin="0,2,0,0"/>
            </StackPanel>
          </Grid>
        </Border>
        <StackPanel x:Name="OtherGpuHost" Margin="0,4,0,8"/>
        </StackPanel>

        <TextBlock Grid.Row="4" x:Name="SectionTitle" Text="图形" Style="{StaticResource Section}"/>

        <Border x:Name="CardHost" Grid.Row="5" Style="{StaticResource Card}">
        <Grid>
          <StackPanel x:Name="GamesPanel" Visibility="Collapsed" Margin="0,4,0,0">
            <Grid Margin="16,8,16,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Column="0">
                <TextBox x:Name="GameSearch" Height="28" VerticalContentAlignment="Center"
                         Background="#1C1C1E" Foreground="#E5E5EA" BorderBrush="#333335" Padding="8,0"/>
                <TextBlock x:Name="GameSearchHint" Text="搜索游戏" Foreground="#636366" FontSize="12"
                           Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
              </Grid>
              <Button x:Name="AddGameBtn" Grid.Column="1" Content="添加游戏" Width="88" Height="28" Margin="8,0,0,0"
                      Background="#2C2C2E" Foreground="#E5E5EA" BorderBrush="#333335"/>
              <Button x:Name="ResetAllGamesBtn" Grid.Column="2" Content="重置所有游戏" Width="104" Height="28" Margin="8,0,0,0"
                      Background="#2C2C2E" Foreground="#FF9F0A" BorderBrush="#333335"/>
            </Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <WrapPanel x:Name="GameGrid" Margin="12,4,12,12"/>
            </ScrollViewer>
          </StackPanel>
          <Grid>
            <Grid x:Name="GraphicsPanel">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Background="#232325" CornerRadius="8" Margin="8,8,8,2" Padding="12,7">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="AutoCoverBtn" Grid.Column="1" Content="自动获取封面" Visibility="Collapsed"
                          Height="24" Padding="12,0" Margin="0,0,196,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Cursor="Hand" FontSize="11" Foreground="#F2F2F7" BorderThickness="1" BorderBrush="#5A5A5C"
                          Background="#3A3A3C"/>
                  <Button x:Name="CoverBtn" Grid.Column="1" Content="设置封面" Visibility="Collapsed"
                          Height="24" Padding="12,0" Margin="0,0,96,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Cursor="Hand" FontSize="11" Foreground="#F2F2F7" BorderThickness="1" BorderBrush="#5A5A5C">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Background" Value="#3A3A3C"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter Property="Background" Value="#4A4A4C"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                  <Setter Property="Background" Value="#FF9F0A"/>
                                  <Setter Property="Foreground" Value="#1C1C1E"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </Button.Style>
                  </Button>
                  <Button x:Name="ResetBtn" Grid.Column="1" Content="重置" Visibility="Collapsed"
                          Height="22" Padding="10,0" Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                          Background="#2C2C2E" BorderThickness="0" FontSize="11" Foreground="#FF9F0A"/>
                  <TextBlock x:Name="HintText" Grid.Column="1" IsHitTestVisible="False" Margin="0,0,200,0" Text="把鼠标移到任意选项上，这里显示详细说明"
                             Foreground="#8E8E93" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
              </Border>
              <ScrollViewer x:Name="RowsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6">
                <StackPanel x:Name="RowsHost" Margin="0,0,0,0"/>
              </ScrollViewer>
            </Grid>
            <Grid x:Name="OcPanel" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6">
                <StackPanel x:Name="OcHost" Margin="16,8,16,8"/>
              </ScrollViewer>
            </Grid>
            <Grid x:Name="DisplayPanel" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6">
                <StackPanel x:Name="DisplayHost" Margin="0,8,0,8"/>
              </ScrollViewer>
            </Grid>
            <Grid x:Name="ProfilesPanel" Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,6">
                <StackPanel x:Name="ProfilesHost" Margin="16,8,16,8"/>
              </ScrollViewer>
            </Grid>
          </Grid>
        </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
